<!-- COLLECTION PAGE -->
<div class="collection-hero">
  <div class="container">
    <h1 class="collection-title serif">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <p class="collection-desc">{{ collection.description }}</p>
    {%- endif -%}
  </div>
</div>

<section class="products-section">
  <div class="container">

    <!-- FILTER BAR -->
    <div class="filter-bar">
      <button class="filter-btn {% unless current_tags %}active{% endunless %}"
              data-filter="all">Todos</button>

      {%- assign vendors = collection.all_vendors -%}
      {%- for vendor in vendors limit: 12 -%}
        <button class="filter-btn {% if current_tags contains vendor %}active{% endif %}"
                data-filter="{{ vendor }}"
                data-filter-type="vendor">{{ vendor }}</button>
      {%- endfor -%}
    </div>

    <!-- SORT + COUNT -->
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;font-size:12px;color:var(--muted);">
      <span>{{ collection.products_count }} produto{{ collection.products_count | pluralize: '', 's' }}</span>
      <div style="display:flex;align-items:center;gap:8px;">
        <label for="sort-select" style="letter-spacing:.05em;text-transform:uppercase;font-size:10px;">Ordenar:</label>
        <select id="sort-select" onchange="window.location=this.value"
                style="background:var(--black-2);border:1px solid rgba(205,166,90,.15);color:var(--off-white);padding:6px 12px;font-size:11px;cursor:pointer;">
          <option value="{{ collection.url }}?sort_by=manual"           {% if collection.sort_by == 'manual' %}selected{% endif %}>Em Destaque</option>
          <option value="{{ collection.url }}?sort_by=best-selling"     {% if collection.sort_by == 'best-selling' %}selected{% endif %}>Mais Vendidos</option>
          <option value="{{ collection.url }}?sort_by=price-ascending"  {% if collection.sort_by == 'price-ascending' %}selected{% endif %}>Menor Preço</option>
          <option value="{{ collection.url }}?sort_by=price-descending" {% if collection.sort_by == 'price-descending' %}selected{% endif %}>Maior Preço</option>
          <option value="{{ collection.url }}?sort_by=created-descending" {% if collection.sort_by == 'created-descending' %}selected{% endif %}>Mais Novos</option>
          <option value="{{ collection.url }}?sort_by=title-ascending"  {% if collection.sort_by == 'title-ascending' %}selected{% endif %}>A–Z</option>
        </select>
      </div>
    </div>

    <!-- PRODUCT GRID -->
    <div class="product-grid">
      {%- for product in collection.products -%}
        {%- render 'product-card', product: product -%}
      {%- else -%}
        <p style="color:var(--muted);padding:60px 0;grid-column:1/-1;text-align:center;">
          Nenhum produto encontrado nesta coleção.
        </p>
      {%- endfor -%}
    </div>

    <!-- PAGINATION -->
    {%- if paginate.pages > 1 -%}
      <div class="pagination">
        {%- if paginate.previous -%}
          <a href="{{ paginate.previous.url }}" class="page-btn">‹</a>
        {%- endif -%}

        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}
            <a href="{{ part.url }}" class="page-btn">{{ part.title }}</a>
          {%- else -%}
            <span class="page-btn active">{{ part.title }}</span>
          {%- endif -%}
        {%- endfor -%}

        {%- if paginate.next -%}
          <a href="{{ paginate.next.url }}" class="page-btn">›</a>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</section>

{%- paginate collection.products by 48 -%}{%- endpaginate -%}
