<!-- PRODUCT PAGE -->
<div class="product-page">
  <div class="container">
    <div class="product-layout">

      <!-- GALLERY -->
      <div>
        <div class="product-gallery-main">
          {%- if product.featured_image -%}
            <img src="{{ product.featured_image | image_url: width: 900 }}"
                 alt="{{ product.featured_image.alt | escape | default: product.title }}"
                 id="main-product-img"
                 loading="eager">
          {%- else -%}
            <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:var(--black-3);">
              <svg width="80" height="100" viewBox="0 0 64 80" fill="none" style="opacity:.15">
                <rect x="24" y="8" width="16" height="8" rx="2" fill="#CDA65A"/>
                <rect x="16" y="16" width="32" height="56" rx="4" fill="#CDA65A"/>
              </svg>
            </div>
          {%- endif -%}
        </div>

        {%- if product.images.size > 1 -%}
          <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:4px;margin-top:4px;">
            {%- for image in product.images limit: 4 -%}
              <img src="{{ image | image_url: width: 200 }}"
                   alt="{{ image.alt | escape }}"
                   loading="lazy"
                   onclick="document.getElementById('main-product-img').src='{{ image | image_url: width: 900 }}'"
                   style="aspect-ratio:1;object-fit:cover;cursor:pointer;opacity:{{ forloop.first | iif: '1', '0.6' }};transition:.15s;">
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- INFO -->
      <div class="product-info">
        <div class="product-brand">{{ product.vendor }}</div>
        <h1 class="product-title serif">{{ product.title }}</h1>
        <div class="product-conc">Alpha Niche · Decant Autêntico</div>

        <div class="product-price" id="product-price">
          R$ {{ product.selected_or_first_available_variant.price | money_without_currency | replace: '.', ',' }}
        </div>

        {%- form 'product', product -%}
          {%- if product.variants.size > 1 -%}
            <div class="variant-label">Tamanho</div>
            <div class="variant-options">
              {%- for variant in product.variants -%}
                <button type="button"
                        class="variant-btn {% if forloop.first %}selected{% endif %}"
                        data-variant-id="{{ variant.id }}"
                        data-price="{{ variant.price }}">
                  {{ variant.title }}
                </button>
              {%- endfor -%}
            </div>
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          {%- else -%}
            <input type="hidden" name="id" value="{{ product.variants.first.id }}">
          {%- endif -%}

          <button type="submit" name="add" class="add-to-cart"
                  data-add-to-cart
                  {% unless product.available %}disabled{% endunless %}>
            {%- if product.available -%}Adicionar ao Carrinho{%- else -%}Esgotado{%- endif -%}
          </button>
        {%- endform -%}

        <!-- DESCRIPTION -->
        {%- if product.description != blank -%}
          <div class="product-desc">
            {{ product.description }}
          </div>
        {%- endif -%}

        <!-- DETAILS -->
        <div style="margin-top:28px;padding-top:24px;border-top:1px solid rgba(205,166,90,.1);">
          <div style="display:grid;gap:10px;">
            <div style="display:flex;gap:12px;font-size:12px;">
              <span style="color:var(--muted);min-width:80px;text-transform:uppercase;letter-spacing:.08em;">Marca</span>
              <span style="color:var(--off-white);">{{ product.vendor }}</span>
            </div>
            <div style="display:flex;gap:12px;font-size:12px;">
              <span style="color:var(--muted);min-width:80px;text-transform:uppercase;letter-spacing:.08em;">Tipo</span>
              <span style="color:var(--off-white);">Decant Autêntico</span>
            </div>
            {%- if product.type != blank -%}
            <div style="display:flex;gap:12px;font-size:12px;">
              <span style="color:var(--muted);min-width:80px;text-transform:uppercase;letter-spacing:.08em;">Categoria</span>
              <span style="color:var(--off-white);">{{ product.type }}</span>
            </div>
            {%- endif -%}
          </div>
        </div>
      </div>

    </div>

    <!-- RELATED PRODUCTS -->
    {%- assign related = collections[product.collections.first.handle].products | where: 'id', product.id -%}
    {%- assign vendor_products = collections.all.products | where: 'vendor', product.vendor -%}
    {%- if vendor_products.size > 1 -%}
      <div style="margin-top:80px;">
        <div class="sec-head">
          <span class="sec-eyebrow">{{ product.vendor }}</span>
          <h2 class="sec-title">Mais da <em>Mesma Marca</em></h2>
        </div>
        <div class="product-grid">
          {%- for p in vendor_products limit: 4 -%}
            {%- unless p.id == product.id -%}
              {%- render 'product-card', product: p -%}
            {%- endunless -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

  </div>
</div>
