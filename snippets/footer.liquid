<script>
window.alphaQuickAdd=function(btn,id){var t=btn.textContent;btn.disabled=true;btn.textContent='...';fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:id,quantity:1})}).then(function(r){return r.ok?r.json():Promise.reject();}).then(function(){btn.textContent='✓ Adicionado';btn.classList.add('added');setTimeout(function(){btn.textContent=t;btn.classList.remove('added');btn.disabled=false;},2200);}).catch(function(){btn.textContent='Erro';setTimeout(function(){btn.textContent=t;btn.disabled=false;},1800);});};
document.addEventListener('DOMContentLoaded',function(){var bar=document.getElementById('sticky-atc');var trigger=document.querySelector('[data-main-atc]');if(!bar||!trigger)return;new IntersectionObserver(function(e){bar.classList.toggle('visible',!e[0].isIntersecting);},{threshold:0}).observe(trigger);});
window.alphaNewsletter=function(e,f){e.preventDefault();var btn=f.querySelector('button');var inp=f.querySelector('input');btn.textContent='...';fetch('/contact',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:'contact[email]='+encodeURIComponent(inp.value)+'&contact[body]=Newsletter&form_type=contact&utf8=%E2%9C%93'}).then(function(){btn.textContent='✓ Inscrito!';inp.value='';setTimeout(function(){btn.textContent='Assinar';},3000);});return false;};
</script>
