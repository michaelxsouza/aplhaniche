{% comment %} Search Results — usa snippet product-card {% endcomment %}

<style>
  :root {
    --sr-gold: rgba(205,166,90,1);
    --sr-gold-dim: rgba(205,166,90,0.15);
    --sr-bg: #080604;
    --sr-text: #f0ebe3;
    --sr-muted: rgba(240,235,227,0.45);
    --sr-border: rgba(205,166,90,0.18);
  }

  .sr-page {
    background: var(--sr-bg);
    min-height: 100vh;
    padding: 0 0 80px;
    font-family: var(--font-sans, sans-serif);
  }

  .sr-header {
    padding: 60px 40px 40px;
    border-bottom: 1px solid var(--sr-border);
    max-width: 1400px;
    margin: 0 auto;
  }
  .sr-eyebrow {
    font-size: 10px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--sr-gold);
    margin-bottom: 12px;
  }
  .sr-query {
    font-size: clamp(28px, 5vw, 56px);
    font-weight: 300;
    color: var(--sr-text);
    line-height: 1.1;
    margin: 0 0 12px;
  }
  .sr-query strong {
    color: var(--sr-gold);
    font-weight: 600;
  }
  .sr-count {
    font-size: 13px;
    color: var(--sr-muted);
    letter-spacing: 0.05em;
  }

  .sr-refine {
    background: rgba(255,255,255,0.03);
    border-bottom: 1px solid var(--sr-border);
  }
  .sr-refine-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 16px 40px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .sr-refine-input {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--sr-text);
    font-size: 14px;
    font-family: inherit;
    outline: none;
  }
  .sr-refine-input::placeholder { color: var(--sr-muted); }
  .sr-refine-btn {
    background: var(--sr-gold);
    color: #000;
    border: none;
    padding: 8px 20px;
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    cursor: pointer;
    font-family: inherit;
    font-weight: 600;
    transition: opacity 0.2s;
  }
  .sr-refine-btn:hover { opacity: 0.85; }

  .sr-container {
    max-width: 1400px;
    margin: 48px auto 0;
    padding: 0 40px;
  }
  .sr-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
  }
  @media (max-width: 1024px) { .sr-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 720px) { .sr-grid { grid-template-columns: repeat(2, 1fr); gap: 16px; } }
  @media (max-width: 480px) { .sr-grid { grid-template-columns: 1fr; } }

  .sr-empty {
    text-align: center;
    padding: 80px 20px;
    color: var(--sr-muted);
  }
  .sr-empty-icon {
    font-size: 48px;
    margin-bottom: 20px;
    opacity: 0.4;
  }
  .sr-empty-title {
    font-size: 22px;
    font-weight: 300;
    color: var(--sr-text);
    margin-bottom: 8px;
  }
  .sr-empty-sub { font-size: 14px; }

  /* Adapta product-card para fundo escuro da pagina de busca */
  .sr-page .product-card {
    background: #0f0d09;
    border: 1px solid rgba(205,166,90,0.12);
    transition: border-color 0.3s, transform 0.3s;
  }
  .sr-page .product-card:hover {
    border-color: rgba(205,166,90,0.4);
    transform: translateY(-4px);
  }
  .sr-page .product-card-vendor { color: var(--sr-gold); }
  .sr-page .product-card-title { color: var(--sr-text); }
  .sr-page .product-card-price-current { color: var(--sr-text); }
  .sr-page .product-card-price-compare { color: var(--sr-muted); text-decoration: line-through; }
</style>

<div class="sr-page">
  {% if search.performed %}
    <div class="sr-header">
      <p class="sr-eyebrow">Resultados da Pesquisa</p>
      <h1 class="sr-query">
        {% if search.results_count > 0 %}
          Perfumes para <strong>"{{ search.terms | escape }}"</strong>
        {% else %}
          Sem resultados para <strong>"{{ search.terms | escape }}"</strong>
        {% endif %}
      </h1>
      <p class="sr-count">
        {% if search.results_count == 1 %}
          1 perfume encontrado
        {% elsif search.results_count > 1 %}
          {{ search.results_count }} perfumes encontrados
        {% endif %}
      </p>
    </div>

    <div class="sr-refine">
      <form action="/search" method="get" class="sr-refine-inner">
        <input type="hidden" name="type" value="product">
        <input
          type="text"
          name="q"
          class="sr-refine-input"
          value="{{ search.terms | escape }}"
          placeholder="Refinar pesquisa..."
          autocomplete="off"
        >
        <button type="submit" class="sr-refine-btn">Pesquisar</button>
      </form>
    </div>

    <div class="sr-container">
      {% if search.results_count > 0 %}
        <div class="sr-grid">
          {% for product in search.results %}
            {% render 'product-card', product: product %}
          {% endfor %}
        </div>
      {% else %}
        <div class="sr-empty">
          <div class="sr-empty-icon">&#9672;</div>
          {% if search.terms != blank %}
            <p class="sr-empty-title">Nenhum perfume encontrado</p>
            <p class="sr-empty-sub">Tente buscar pela marca, nota olfativa ou categoria</p>
          {% else %}
            <p class="sr-empty-title">Pesquise nossa coleção</p>
            <p class="sr-empty-sub">Digite o nome do perfume, marca ou nota olfativa</p>
          {% endif %}
        </div>
      {% endif %}
    </div>
  {% else %}
    <div class="sr-refine">
      <form action="/search" method="get" class="sr-refine-inner">
        <input type="hidden" name="type" value="product">
        <input
          type="text"
          name="q"
          class="sr-refine-input"
          placeholder="Pesquise por perfumes, marcas, notas..."
          autocomplete="off"
          autofocus
        >
        <button type="submit" class="sr-refine-btn">Pesquisar</button>
      </form>
    </div>
    <div class="sr-container">
      <div class="sr-empty">
        <div class="sr-empty-icon">&#9672;</div>
        <p class="sr-empty-title">Pesquise nossa coleção</p>
        <p class="sr-empty-sub">Digite o nome do perfume, marca ou nota olfativa</p>
      </div>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Resultados da Pesquisa",
  "settings": []
}
{% endschema %}