<section class="products-section">
  <div class="container">
    <div class="sec-head">
      <span class="sec-eyebrow">{{ section.settings.eyebrow | default: 'Curadoria Exclusiva' }}</span>
      <h2 class="sec-title">{{ section.settings.title | default: 'Mais <em>Desejados</em>' }}</h2>
      {%- if section.settings.subtitle != blank -%}
        <p class="sec-sub">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    {%- if section.settings.collection != blank -%}
      {%- assign featured_collection = collections[section.settings.collection] -%}
    {%- else -%}
      {%- assign featured_collection = collections.all -%}
    {%- endif -%}

    <div class="product-grid">
      {%- for product in featured_collection.products limit: section.settings.products_count -%}
        {%- render 'product-card', product: product -%}
      {%- else -%}
        <p style="color:var(--muted);padding:40px 0;">Nenhum produto encontrado.</p>
      {%- endfor -%}
    </div>

    {%- if section.settings.show_view_all -%}
      <div style="text-align:center;margin-top:48px">
        <a href="/collections/all" class="btn-outline">Ver Todos os Produtos</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Produtos em Destaque",
  "settings": [
    {"type": "text",       "id": "eyebrow",        "label": "Eyebrow",         "default": "Curadoria Exclusiva"},
    {"type": "text",       "id": "title",           "label": "Título",          "default": "Mais Desejados"},
    {"type": "text",       "id": "subtitle",        "label": "Subtítulo",       "default": ""},
    {"type": "collection", "id": "collection",      "label": "Coleção"},
    {"type": "range",      "id": "products_count",  "label": "Quantidade",      "min": 4, "max": 16, "step": 4, "default": 8},
    {"type": "checkbox",   "id": "show_view_all",   "label": "Mostrar 'Ver todos'", "default": true}
  ],
  "presets": [{"name": "Produtos em Destaque"}]
}
{% endschema %}
