<section class="hero-full" style="{% if section.settings.bg_image != blank %}background-image:url('{{ section.settings.bg_image | image_url: width: 2000 }}');{% endif %}">
  <div class="hero-overlay"></div>
  <div class="hero-inner">
    <div class="hero-text">
      <div class="hero-eyebrow-line">
        <span class="hero-line"></span>
        <span class="hero-eyebrow-text">{{ section.settings.eyebrow | default: 'Perfumaria de Prestígio' }}</span>
      </div>
      <h1 class="hero-heading">
        {{ section.settings.headline | default: 'A essência do' }}<br>
        <em class="hero-heading-em">{{ section.settings.headline_em | default: 'extraordinário' }}</em>
      </h1>
      <p class="hero-sub">{{ section.settings.subheadline | default: 'Decants e perfumes das casas mais icônicas do mundo. Descubra fragrâncias raras, experimente antes de investir.' }}</p>
      <div class="hero-cta">
        <a href="{{ section.settings.primary_btn_url | default: '/collections/all' }}" class="btn-primary">
          {{ section.settings.primary_btn_label | default: 'Explorar Coleção' }}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href="{{ section.settings.secondary_btn_url | default: '/pages/o-que-e-decant' }}" class="btn-outline">
          {{ section.settings.secondary_btn_label | default: 'O que é um Decant?' }}
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {"type": "image_picker", "id": "bg_image",            "label": "Imagem de fundo"},
    {"type": "text",         "id": "eyebrow",             "label": "Eyebrow",              "default": "Perfumaria de Prestígio"},
    {"type": "text",         "id": "headline",            "label": "Título (linha 1)",      "default": "A essência do"},
    {"type": "text",         "id": "headline_em",         "label": "Título (linha 2 itálico dourado)", "default": "extraordinário"},
    {"type": "textarea",     "id": "subheadline",         "label": "Subtítulo",            "default": "Decants e perfumes das casas mais icônicas do mundo. Descubra fragrâncias raras, experimente antes de investir."},
    {"type": "text",         "id": "primary_btn_label",  "label": "Botão primário",        "default": "Explorar Coleção"},
    {"type": "url",          "id": "primary_btn_url",    "label": "Link primário",         "default": "/collections/all"},
    {"type": "text",         "id": "secondary_btn_label","label": "Botão secundário",      "default": "O que é um Decant?"},
    {"type": "url",          "id": "secondary_btn_url",  "label": "Link secundário",       "default": "/pages/o-que-e-decant"}
  ],
  "presets": [{"name": "Hero"}]
}
{% endschema %}
