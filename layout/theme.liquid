<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ page_description | default: shop.description | default: 'Alpha Niche — Perfumes e Decants Premium' }}">

  <title>
    {%- if template.name == 'index' -%}
      Alpha Niche — Perfumes &amp; Decants Premium
    {%- else -%}
      {{ page_title }} — Alpha Niche
    {%- endif -%}
  </title>

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32 }}">
  {%- endif -%}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

  {{ content_for_header }}

  {{ 'theme.css' | asset_url | stylesheet_tag }}
</head>

<body>

  {%- render 'announcement-bar' -%}
  {%- render 'header' -%}

  <main id="main-content" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {%- render 'footer' -%}
  {%- render 'cart-drawer' -%}

  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
